<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="wcg.yhm.ymm.data.align.mapper.UpdateRecordMapper">
    <update id="updateUserFollowingCountByUserId"  parameterType="map">
        UPDATE `user_count` set following_total = #{count}
        WHERE user_id = #{user_id}
    </update>
</mapper>